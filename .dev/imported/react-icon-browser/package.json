{
  "name": "@ichava/react-icon-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ichava icon browser: the React 19 component library and standalone app behind ichava/icon-browser, for the Ichava Laravel icon ecosystem.",
  "keywords": [
    "ichava",
    "icons",
    "svg",
    "icon-browser",
    "react",
    "laravel"
  ],
  "homepage": "https://github.com/ichava/react-icon-browser/tree/main/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichava/react-icon-browser.git"
  },
  "bugs": {
    "url": "https://github.com/ichava/react-icon-browser/issues"
  },
  "license": "UNLICENSED",
  "author": "Simtabi LLC <ichava@simtabi.com> (https://simtabi.com)",
  "engines": {
    "node": ">=24"
  },
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./prepaint.html": "./dist/lib/prepaint.html",
    "./source": "./src/index.ts",
    "./source/styles.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --port 5174",
    "fixture": "node scripts/generate-fixture.mjs",
    "schema:types": "node scripts/schema-types.mjs",
    "check:schema-types": "node scripts/schema-types.mjs --check",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/rewrite-lib-type-paths.mjs && node scripts/check-lib-build.mjs",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "visual": "playwright test --config=playwright.visual.config.ts",
    "visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "lint": "eslint . --max-warnings 0",
    "check:consumers": "node scripts/check-consumers.mjs",
    "check:dead-classes": "node scripts/check-dead-classes.mjs",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "boundaries:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot",
    "visual:linux": "sh scripts/linux.sh visual-update",
    "visual:linux:check": "sh scripts/linux.sh visual-check",
    "e2e:linux": "sh scripts/linux.sh e2e",
    "check:playwright-image": "node scripts/check-playwright-image.mjs",
    "check:public-api": "node scripts/check-public-api.mjs",
    "check:boundary-rules": "node scripts/check-boundary-rules.mjs",
    "check:dead-links": "node scripts/check-dead-links.mjs",
    "check:config-drift": "node scripts/check-config-drift.mjs tsconfig.base.json=config/tsconfig.base.json eslint.base.js=config/eslint.base.js scripts/check-config-drift.mjs=config/check-config-drift.mjs scripts/check-consumers.mjs=config/tools/check-consumers.mjs scripts/siblings.mjs=config/tools/siblings.mjs scripts/siblings.d.mts=config/tools/siblings.d.mts scripts/prepaint.mjs=config/tools/prepaint.mjs scripts/prepaint.d.mts=config/tools/prepaint.d.mts scripts/visual-drift.mjs=config/tools/visual-drift.mjs scripts/check-dead-links.mjs=config/tools/check-dead-links.mjs",
    "typecheck:domain": "tsc -p tsconfig.domain.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json && tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@ichava/js-ui-kernel": "git+https://github.com/ichava/js-ui-kernel.git#v0.1.0",
    "@react-stately/utils": "^3.12.1",
    "@tanstack/react-virtual": "^3.14.14",
    "@tabler/icons-react": "^3.50.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "input-otp": "^1.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "zustand": ">=5.0.15 <5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@ichava/js-motion": "git+https://github.com/ichava/js-motion.git#66b2773213dbbebdcf30932f4efc2061fc6fa521",
    "@playwright/test": "~1.65.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/color": "^4.2.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "playwright-core": "~1.65.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3",
    "zustand": ">=5.0.15 <5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}

# Force LF line endings for shell scripts so Windows clones don't break
# the shebang and CR-aware shell builtins.
*.sh    text eol=lf
*.bash  text eol=lf

# Treat the JSON config files as text (no normalisation surprises).
*.json  text
*.yml   text
*.yaml  text

# SVG icons are binary-stable, no eol normalisation.
*.svg   -text

# Files excluded from `composer require` distribution archives — these
# are useful for development but pure noise in a consumer's vendor/.
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.github                export-ignore
/CONTRIBUTING.md        export-ignore
/phpunit.xml            export-ignore
/phpunit.xml.dist       export-ignore
/tests                  export-ignore
/docs                   export-ignore
/.dev                   export-ignore
/phpstan.neon.dist      export-ignore


# The browser's source lives in resources/js since react consolidation 3d (2026-11-12). Its
# tests and test fixtures are development-only, so the archive carries the source a host
# rebuilds from and nothing else. Its tooling and imported root files are under /.dev above.
/resources/js/**/*.test.ts      export-ignore
/resources/js/**/*.test.tsx     export-ignore
/resources/js/test              export-ignore
/resources/vendor/react-icon-browser/DEPRECATED.md export-ignore

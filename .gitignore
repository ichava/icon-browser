# Dependencies
/vendor
/node_modules

# IDE / editor cruft
/.idea
/.vscode
/.fleet
/.zed
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db

# Composer
composer.lock
auth.json

# PHP test + lint caches
/.phpunit.cache
.phpunit.result.cache
/.phpstan.cache
/.pint.cache
/.php-cs-fixer.cache
/.psalm
/coverage
coverage.xml
clover.xml

# Frontend build output
/public/build
/public/.vite
/public/hot
/public/vendor

# Local env / config overrides
.env
.env.local
.env.*.local
composer.local.json

# Logs
*.log

# Local dev tooling — log directories created by .dev/ helper scripts.
# Pattern matches .dev/.<basename>-logs/ for any helper following the
# convention.
/.dev/.*-logs/
package-lock.json

# Agent worktrees and local design notes. Tailwind's source scan honours this file but not
# a global git excludes file, so without this line it reads every checkout under
# .claude/worktrees/ and the committed inertia-app.css grows by the classes they use.
/.claude/

# Generated by .dev/browser/sample-svg-archetypes.mjs from the private bundled and Metronic packs
# for the local svg-baseline rendering check. Never tracked: this repository is public.
/.dev/browser/public/baseline/
/.dev/imported/react-icon-browser/e2e/svg-baseline.spec.ts-snapshots/*bundled*
/.dev/imported/react-icon-browser/e2e/svg-baseline.spec.ts-snapshots/*metronic*

# The e2e harness build (e2e/browser/vite.config.ts) and Playwright output.
/.cache/
/playwright-report/
/test-results/

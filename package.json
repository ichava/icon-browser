{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ichava/icon-browser",
  "version": "0.1.0",
  "description": "Inertia + React adapter for the Ichava icon browser (Laravel). The browser UI's source lives in resources/js (imported from react-icon-browser).",
  "private": true,
  "license": "UNLICENSED",
  "author": "Simtabi LLC <ichava@simtabi.com> (https://simtabi.com)",
  "homepage": "https://github.com/ichava/icon-browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichava/icon-browser.git"
  },
  "bugs": {
    "url": "https://github.com/ichava/icon-browser/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "check:config-drift": "node .dev/tools/check-config-drift.mjs eslint.base.js=config/eslint.base.js tsconfig.base.json=config/tsconfig.base.json .dev/tools/sync-vendored-library.mjs=config/tools/sync-vendored-library.mjs .dev/tools/check-config-drift.mjs=config/check-config-drift.mjs",
    "// clean": "Narrow on purpose. inertia-app.js/.css are CHECKED IN and no npm script or CI job rebuilds them -- only build does. rm -rf public/* destroyed them, and a failing vite build destroyed them for nothing. Delete only what the build re-emits. See issue #26.",
    "clean": "rm -rf public/assets/js/inertia-app*.js public/assets/css/inertia-app.css public/.vite 2>/dev/null || true",
    "build": "npm run clean && echo '' && echo '🔨 Building Ichava (dev)...' && NODE_ENV=development vite build --config vite.inertia.config.ts",
    "build:prod": "npm run clean && echo '' && echo '🚀 Building Ichava (production)...' && NODE_ENV=production vite build --config vite.inertia.config.ts",
    "watch": "echo '' && echo '👀 Watching Ichava for changes...' && vite build --watch --config vite.inertia.config.ts",
    "dev": "vite --config vite.inertia.config.ts",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "typecheck:inertia": "tsc -p tsconfig.inertia.json",
    "typecheck:domain": "tsc -p tsconfig.domain.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/browser/tsconfig.json",
    "build:prepaint": "node .dev/browser/write-prepaint.mjs",
    "lint": "eslint resources/js --max-warnings 0",
    "ci:manual": "node .dev/tools/manual-ci.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:browser": "playwright test --config e2e/browser/playwright.config.ts",
    "visual": "playwright test --config e2e/browser/playwright.visual.config.ts",
    "visual:update": "playwright test --config e2e/browser/playwright.visual.config.ts --update-snapshots",
    "visual:linux": "sh .dev/browser/linux.sh visual-update",
    "visual:linux:check": "sh .dev/browser/linux.sh visual-check",
    "e2e:linux": "sh .dev/browser/linux.sh e2e",
    "boundaries": "depcruise resources/js --config .dependency-cruiser.cjs",
    "check:boundary-rules": "node .dev/browser/check-boundary-rules.mjs",
    "schema:types": "node .dev/browser/schema-types.mjs",
    "check:schema-types": "node .dev/browser/schema-types.mjs --check",
    "check:dead-classes": "node .dev/browser/check-dead-classes.mjs",
    "check:dead-links": "node .dev/browser/check-dead-links.mjs",
    "check:playwright-image": "node .dev/browser/check-playwright-image.mjs"
  },
  "keywords": [
    "icons",
    "svg",
    "ichava",
    "react",
    "inertia",
    "tailwindcss",
    "laravel"
  ],
  "dependencies": {
    "@ichava/js-motion": "git+https://github.com/ichava/js-motion.git#v0.1.0",
    "@ichava/js-ui-kernel": "git+https://github.com/ichava/js-ui-kernel.git#v0.1.0",
    "@inertiajs/react": "^3.0",
    "@react-stately/utils": "^3.12.1",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-virtual": "^3.14.14",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "input-otp": "^1.5.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tw-animate-css": "^1.4.0",
    "zustand": ">=5.0.15 <5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.65.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/color": "^4.2.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.6",
    "sass": "^1.94.2",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
